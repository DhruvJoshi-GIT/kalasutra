# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kalasutra
JWT_SECRET=dev-only-secret-change-me-on-heroku-0123456789abcdef
OTP_DEV_MODE=1
OTP_DEV_CODE=123456
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,https://dhruvjoshi-git.github.io,https://kalasutra.live,https://www.kalasutra.live
ADMIN_KEY=

# files: db (Postgres bytea, default) | local | s3
STORAGE_BACKEND=db
PUBLIC_BASE_URL=

# serve web/ (or prototype/) from the API in local dev
SERVE_WEB=1

# AI: fixture | record | live  (empty per-provider mode = live if its key is set, else fixture)
AI_MODE=fixture
SARVAM_API_KEY=
SARVAM_MODE=
ANTHROPIC_API_KEY=
ANTHROPIC_MODE=
VOYAGE_API_KEY=
VOYAGE_MODE=
FAL_KEY=
FAL_MODE=
